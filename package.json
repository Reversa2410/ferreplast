{
  "name": "ferreplast",
  "version": "0.1.0",
  "description": "Sistema de gestion e inventario para ferreteria y plastiqueria",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run db:test && npm run test:api",
    "db:crear": "sqlcmd -S localhost -E -C -f 65001 -b -i db/schema.sql",
    "db:datos": "sqlcmd -S localhost -E -C -f 65001 -b -i db/seed.sql",
    "db:test": "sqlcmd -S localhost -E -C -f 65001 -b -i db/test-esquema.sql",
    "db:reset": "npm run db:crear && npm run db:datos && npm run db:test",
    "test:api": "node src/test-api.mjs",
    "dev": "node --env-file-if-exists=.env src/servidor.mjs",
    "diagramas": "node docs/diagramas/_generar.mjs && node docs/diagramas/_verificar.mjs",
    "word": "node docs/word/construir.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.4.0",
    "docx": "^9.7.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.1",
    "msnodesqlv8": "^6.2.2",
    "mssql": "^12.7.14",
    "zod": "^4.5.2"
  }
}
