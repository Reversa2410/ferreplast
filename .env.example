# =============================================================================
# FERREPLAST -- Plantilla de variables de entorno
#
# Copiar este archivo como .env y ajustar lo que haga falta.
# El archivo .env esta en .gitignore: NUNCA se sube al repositorio.
#
# NINGUNA de estas variables es obligatoria. Los valores por defecto apuntan a
# un SQL Server local con autenticacion de Windows, que es el caso de
# desarrollo: `npm run dev` arranca sin crear este archivo.
# =============================================================================

# ----------------------------------------------------------------------------
# Base de datos
#
# La conexion usa la identidad de Windows del proceso (Trusted_Connection), asi
# que NO hay usuario ni contrasenia que guardar. Esa es la razon por la que este
# archivo ya no contiene ninguna credencial.
# ----------------------------------------------------------------------------

# Instancia de SQL Server. Para una instancia con nombre: "localhost\SQLEXPRESS".
DB_SERVIDOR=localhost

# Base de datos. Las pruebas de la API NO usan esta: crean y borran
# FerreplastPruebaApi, para no poder tocar los datos de trabajo.
DB_NOMBRE=FerreplastDB

# Driver ODBC. Se necesita el 17 o el 18 instalado (vienen con SQL Server).
DB_DRIVER=ODBC Driver 18 for SQL Server

# ----------------------------------------------------------------------------
# Servidor HTTP
# ----------------------------------------------------------------------------

# Puerto del servidor de la API en desarrollo.
PORT=3001

# Entorno: development | production
NODE_ENV=development
