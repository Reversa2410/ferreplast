# =============================================================================
# FERREPLAST -- Plantilla de variables de entorno
#
# Copiar este archivo como .env y completar con los valores reales.
# El archivo .env esta en .gitignore: NUNCA se sube al repositorio.
# =============================================================================

# Cadena de conexion a PostgreSQL.
# En Neon se obtiene desde el panel del proyecto (Connection string).
# Debe incluir sslmode=require.
DATABASE_URL="postgresql://usuario:contrasenia@host.neon.tech/ferreplast?sslmode=require"

# Clave para firmar los tokens de sesion.
# Generar una al azar, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# Puerto del servidor de la API en desarrollo.
PORT=3001

# Entorno: development | production
NODE_ENV=development
