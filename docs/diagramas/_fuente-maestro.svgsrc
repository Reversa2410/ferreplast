<svg class="dg" viewBox="0 0 1840 1240" role="img"
     aria-label="Modelo entidad-relacion extendido completo de Ferreplast: doce entidades y veintidos relaciones. El negocio agrupa tiendas, usuarios, categorias y productos. El stock resuelve la relacion muchos a muchos entre tienda y producto. Las ventas se detallan en lineas de venta, entidad debil. Los movimientos de inventario registran cada cambio de stock. El usuario se especializa en administrador, encargado y empleado.">
  <defs>
    <marker id="ma" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="var(--azul)"/>
    </marker>
    <marker id="mb" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="var(--ambar)"/>
    </marker>
  </defs>

  <!-- ═══ Titulo ═══ -->
  <text class="titulo" x="60" y="52">FERREPLAST</text>
  <text class="subtitulo" x="60" y="76">Modelo Entidad-Relacion Extendido</text>
  <text class="zona" x="60" y="102">12 entidades · 22 relaciones · 1 jerarquia ISA</text>

  <!-- ═══════════════ ENTIDADES ═══════════════ -->

  <!-- 1. NEGOCIO -->
  <rect class="cab-ent" x="640" y="30" width="240" height="26"/>
  <rect class="ent" x="640" y="56" width="240" height="74"/>
  <text class="nom" x="760" y="49" text-anchor="middle">NEGOCIO</text>
  <text class="pk"  x="654" y="75">id</text>
  <text class="atr" x="654" y="91">nombre, propietario</text>
  <text class="atr" x="654" y="107">moneda, activo</text>

  <!-- 2. CATEGORIA -->
  <rect class="cab-ent" x="60" y="210" width="220" height="26"/>
  <rect class="ent" x="60" y="236" width="220" height="84"/>
  <text class="nom" x="170" y="229" text-anchor="middle">CATEGORIA</text>
  <text class="pk"  x="74" y="255">id</text>
  <text class="atr" x="74" y="271">nombre</text>
  <text class="atr" x="74" y="287">padre_id (FK)</text>

  <!-- 3. TIENDA -->
  <rect class="cab-ent" x="640" y="210" width="240" height="26"/>
  <rect class="ent" x="640" y="236" width="240" height="94"/>
  <text class="nom" x="760" y="229" text-anchor="middle">TIENDA</text>
  <text class="pk"  x="654" y="255">id</text>
  <text class="atr" x="654" y="271">nombre, tipo</text>
  <text class="atr" x="654" y="287">direccion, prefijo</text>
  <text class="atr" x="654" y="303">negocio_id (FK)</text>

  <!-- 4. USUARIO -->
  <rect class="cab-ent" x="1230" y="210" width="240" height="26"/>
  <rect class="ent" x="1230" y="236" width="240" height="94"/>
  <text class="nom" x="1350" y="229" text-anchor="middle">USUARIO</text>
  <text class="pk"  x="1244" y="255">id</text>
  <text class="atr" x="1244" y="271">nombre, rol</text>
  <text class="atr" x="1244" y="287">email, pin_hash</text>
  <text class="atr" x="1244" y="303">tienda_id (FK)</text>

  <!-- 5. DISPOSITIVO -->
  <rect class="cab-ent" x="1580" y="210" width="170" height="26"/>
  <rect class="ent" x="1580" y="236" width="170" height="74"/>
  <text class="nom" x="1665" y="229" text-anchor="middle">DISPOSITIVO</text>
  <text class="pk"  x="1594" y="255">id</text>
  <text class="atr" x="1594" y="271">nombre</text>
  <text class="atr" x="1594" y="287">ultimo_sync</text>

  <!-- 6. SYNC_LOG -->
  <rect class="cab-ent" x="1580" y="400" width="170" height="26"/>
  <rect class="ent" x="1580" y="426" width="170" height="74"/>
  <text class="nom" x="1665" y="419" text-anchor="middle">SYNC_LOG</text>
  <text class="pk"  x="1594" y="445">id</text>
  <text class="atr" x="1594" y="461">enviados</text>
  <text class="atr" x="1594" y="477">duplicados</text>

  <!-- 7. PRODUCTO -->
  <rect class="cab-ent" x="60" y="410" width="240" height="26"/>
  <rect class="ent" x="60" y="436" width="240" height="94"/>
  <text class="nom" x="180" y="429" text-anchor="middle">PRODUCTO</text>
  <text class="pk"  x="74" y="455">id</text>
  <text class="atr" x="74" y="471">codigo, nombre</text>
  <text class="atr" x="74" y="487">precio_costo/venta</text>
  <text class="atr" x="74" y="503">unidad_medida</text>

  <!-- 8. STOCK (entidad asociativa) -->
  <rect class="cab-deb" x="380" y="410" width="220" height="26"/>
  <rect class="ent-aso" x="380" y="436" width="220" height="94"/>
  <text class="nom" x="490" y="429" text-anchor="middle">STOCK</text>
  <text class="pk"  x="394" y="455">tienda_id+producto_id</text>
  <text class="der" x="394" y="471">cantidad (derivado)</text>
  <text class="atr" x="394" y="487">cantidad_minima</text>
  <text class="atr" x="394" y="503">updated_at</text>

  <!-- 9. CAJA -->
  <rect class="cab-ent" x="960" y="410" width="220" height="26"/>
  <rect class="ent" x="960" y="436" width="220" height="114"/>
  <text class="nom" x="1070" y="429" text-anchor="middle">CAJA</text>
  <text class="pk"  x="974" y="455">id</text>
  <text class="atr" x="974" y="471">monto_inicial</text>
  <text class="atr" x="974" y="487">efectivo_esperado</text>
  <text class="atr" x="974" y="503">efectivo_contado</text>
  <text class="der" x="974" y="519">diferencia (derivado)</text>

  <!-- 10. MOVIMIENTO_INVENTARIO -->
  <rect class="cab-ent" x="60" y="620" width="300" height="26"/>
  <rect class="ent" x="60" y="646" width="300" height="154"/>
  <text class="nom" x="210" y="639" text-anchor="middle">MOVIMIENTO_INVENTARIO</text>
  <text class="pk"  x="74" y="665">id</text>
  <text class="atr" x="74" y="681">tipo</text>
  <text class="atr" x="74" y="697">cantidad (+/-)</text>
  <text class="atr" x="74" y="713">costo_unitario</text>
  <text class="atr" x="74" y="729">motivo</text>
  <text class="atr" x="74" y="745">ocurrido_en</text>
  <text class="atr" x="74" y="761">created_at</text>
  <text class="der" x="74" y="783">solo insercion (append-only)</text>

  <!-- 11. VENTA -->
  <rect class="cab-ent" x="620" y="620" width="280" height="26"/>
  <rect class="ent" x="620" y="646" width="280" height="134"/>
  <text class="nom" x="760" y="639" text-anchor="middle">VENTA</text>
  <text class="pk"  x="634" y="665">id</text>
  <text class="atr" x="634" y="681">numero, ocurrido_en</text>
  <text class="atr" x="634" y="697">subtotal, descuento</text>
  <text class="atr" x="634" y="713">total, metodo_pago</text>
  <text class="atr" x="634" y="729">anulada</text>
  <text class="atr" x="634" y="745">tienda_id, caja_id (FK)</text>

  <!-- 12. VENTA_LINEA (entidad debil: doble borde) -->
  <rect class="cab-deb" x="620" y="880" width="280" height="26"/>
  <rect class="ent-deb" x="620" y="906" width="280" height="124"/>
  <rect class="ent-deb-int" x="624" y="910" width="272" height="116"/>
  <text class="nom" x="760" y="899" text-anchor="middle">VENTA_LINEA</text>
  <text class="pk"  x="636" y="929">venta_id + nro</text>
  <text class="atr" x="636" y="945">cantidad</text>
  <text class="atr" x="636" y="961">precio_unitario *</text>
  <text class="atr" x="636" y="977">costo_unitario *</text>
  <text class="atr" x="636" y="993">subtotal</text>
  <text class="zona" x="636" y="1015">* congelado al vender</text>

  <!-- ═══ Especializacion ISA de USUARIO ═══ -->
  <line class="rel-amb" x1="1346" y1="330" x2="1346" y2="546"/>
  <line class="rel-amb" x1="1354" y1="330" x2="1354" y2="546"/>
  <circle class="circ-d" cx="1350" cy="563" r="17"/>
  <text class="card-amb" x="1350" y="568" text-anchor="middle" font-size="13">d</text>
  <line class="rel-amb" x1="1350" y1="580" x2="1350" y2="600"/>
  <polygon class="tri-isa" points="1350,600 1384,638 1316,638"/>
  <text class="card-amb" x="1350" y="629" text-anchor="middle" font-size="10">ISA</text>
  <text class="verb" x="1372" y="440">total</text>
  <text class="verb" x="1372" y="522">disjunta</text>

  <path class="rel-amb" d="M1350,638 V675 H1270 V710"/>
  <path class="rel-amb" d="M1350,675 H1480 V710"/>
  <path class="rel-amb" d="M1480,675 H1690 V710"/>

  <!-- 13. ADMINISTRADOR -->
  <rect class="cab-ent" x="1180" y="710" width="180" height="24"/>
  <rect class="ent" x="1180" y="734" width="180" height="62"/>
  <text class="nom" x="1270" y="727" text-anchor="middle" font-size="12.5">ADMINISTRADOR</text>
  <text class="atr" x="1192" y="753">email</text>
  <text class="atr" x="1192" y="769">password_hash</text>
  <text class="atr" x="1192" y="785">ve las 2 tiendas</text>

  <!-- 14. ENCARGADO -->
  <rect class="cab-ent" x="1390" y="710" width="180" height="24"/>
  <rect class="ent" x="1390" y="734" width="180" height="62"/>
  <text class="nom" x="1480" y="727" text-anchor="middle" font-size="12.5">ENCARGADO</text>
  <text class="atr" x="1402" y="753">pin_hash</text>
  <text class="atr" x="1402" y="769">tienda_id oblig.</text>
  <text class="atr" x="1402" y="785">su tienda</text>

  <!-- 15. EMPLEADO -->
  <rect class="cab-ent" x="1600" y="710" width="180" height="24"/>
  <rect class="ent" x="1600" y="734" width="180" height="62"/>
  <text class="nom" x="1690" y="727" text-anchor="middle" font-size="12.5">EMPLEADO</text>
  <text class="atr" x="1612" y="753">pin_hash</text>
  <text class="atr" x="1612" y="769">tienda_id oblig.</text>
  <text class="atr" x="1612" y="785">solo vender</text>

  <!-- ═══════════════ RELACIONES ═══════════════ -->

  <!-- R1 NEGOCIO -> TIENDA -->
  <path class="rel" d="M760,130 V210" marker-end="url(#ma)"/>
  <text class="card" x="770" y="162">1 : N</text>
  <text class="verb" x="770" y="178">posee</text>

  <!-- R2 NEGOCIO -> USUARIO -->
  <path class="rel" d="M880,60 H1300 V210" marker-end="url(#ma)"/>
  <text class="card" x="960" y="52">1 : N</text>
  <text class="verb" x="1008" y="52">emplea</text>

  <!-- R4 NEGOCIO -> CATEGORIA -->
  <path class="rel" d="M640,60 H170 V210" marker-end="url(#ma)"/>
  <text class="card" x="380" y="52">1 : N</text>
  <text class="verb" x="428" y="52">clasifica</text>

  <!-- R6 NEGOCIO -> PRODUCTO -->
  <path class="rel" d="M640,100 H30 V462 H60" marker-end="url(#ma)"/>
  <text class="card" x="36" y="248" transform="rotate(-90 36 248)">1 : N</text>
  <text class="verb" x="36" y="314" transform="rotate(-90 36 314)">oferta</text>

  <!-- R5 CATEGORIA recursiva -->
  <path class="rel-amb" d="M280,252 H322 V192 H215 V210" marker-end="url(#mb)"/>
  <text class="card-amb" x="330" y="228">1 : N</text>
  <text class="verb" x="330" y="244">contiene</text>
  <text class="verb" x="330" y="260">(recursiva)</text>

  <!-- R7 CATEGORIA -> PRODUCTO -->
  <path class="rel" d="M170,320 V410" marker-end="url(#ma)"/>
  <text class="card" x="180" y="356">0 : N</text>
  <text class="verb" x="180" y="372">agrupa</text>

  <!-- R3 TIENDA -> USUARIO -->
  <path class="rel" d="M880,262 H1230" marker-end="url(#ma)"/>
  <text class="card" x="1000" y="254">1 : N</text>
  <text class="verb" x="1048" y="254">asigna</text>

  <!-- R8a PRODUCTO -> STOCK -->
  <path class="rel-amb" d="M300,470 H380" marker-end="url(#mb)"/>
  <text class="card-amb" x="312" y="462">1 : N</text>

  <!-- R8b TIENDA -> STOCK -->
  <path class="rel-amb" d="M660,330 V470 H600" marker-end="url(#mb)"/>
  <text class="card-amb" x="614" y="392">1 : N</text>
  <text class="verb" x="614" y="408">almacena (M:N)</text>

  <!-- R13 TIENDA -> VENTA -->
  <path class="rel" d="M760,330 V620" marker-end="url(#ma)"/>
  <text class="card" x="770" y="466">1 : N</text>
  <text class="verb" x="770" y="482">vende</text>

  <!-- R18 TIENDA -> CAJA -->
  <path class="rel" d="M860,330 V380 H1070 V410" marker-end="url(#ma)"/>
  <text class="card" x="890" y="372">1 : N</text>
  <text class="verb" x="938" y="372">opera</text>

  <!-- R21 TIENDA -> DISPOSITIVO -->
  <path class="rel" d="M860,210 V170 H1665 V210" marker-end="url(#ma)"/>
  <text class="card" x="1480" y="162">1 : N</text>
  <text class="verb" x="1528" y="162">instala</text>

  <!-- R22 DISPOSITIVO -> SYNC_LOG -->
  <path class="rel" d="M1665,310 V400" marker-end="url(#ma)"/>
  <text class="card" x="1675" y="346">1 : N</text>
  <text class="verb" x="1675" y="362">bitacora</text>

  <!-- R19 USUARIO -> CAJA (rol: abre) -->
  <path class="rel" d="M1230,288 H1120 V410" marker-end="url(#ma)"/>
  <text class="verb" x="1076" y="348">abre</text>

  <!-- R20 USUARIO -> CAJA (rol: cierra) -->
  <path class="rel" d="M1230,310 H1050 V410" marker-end="url(#ma)"/>
  <text class="verb" x="1000" y="348">cierra</text>
  <text class="card" x="1136" y="392">0 : N</text>

  <!-- R14 USUARIO -> VENTA -->
  <path class="rel" d="M1260,330 V580 H940 V660 H900" marker-end="url(#ma)"/>
  <text class="card" x="1190" y="572">0 : N</text>
  <text class="verb" x="1108" y="572">atiende</text>

  <!-- R15 CAJA -> VENTA -->
  <path class="rel" d="M960,530 H920 V700 H900" marker-end="url(#ma)"/>
  <text class="card" x="856" y="596">0 : N</text>
  <text class="verb" x="856" y="612">cobra en</text>

  <!-- R16 VENTA -> VENTA_LINEA (identificadora: doble linea) -->
  <path class="rel-amb" d="M756,780 V880"/>
  <path class="rel-amb" d="M764,780 V880" marker-end="url(#mb)"/>
  <text class="card-amb" x="776" y="818">1 : N</text>
  <text class="verb" x="776" y="834">detalla</text>
  <text class="verb" x="776" y="850">(identificadora)</text>

  <!-- R17 PRODUCTO -> VENTA_LINEA -->
  <path class="rel" d="M290,530 V560 H610 V950 H620" marker-end="url(#ma)"/>
  <text class="card" x="470" y="552">1 : N</text>
  <text class="verb" x="518" y="552">referencia</text>

  <!-- R10 PRODUCTO -> MOVIMIENTO -->
  <path class="rel" d="M180,530 V620" marker-end="url(#ma)"/>
  <text class="card" x="190" y="566">1 : N</text>
  <text class="verb" x="190" y="582">afecta</text>

  <!-- R9 TIENDA -> MOVIMIENTO -->
  <path class="rel" d="M700,330 V600 H380 V680 H360" marker-end="url(#ma)"/>
  <text class="card" x="408" y="592">1 : N</text>
  <text class="verb" x="456" y="592">registra</text>

  <!-- R12 VENTA -> MOVIMIENTO -->
  <path class="rel" d="M620,742 H360" marker-end="url(#ma)"/>
  <text class="card" x="430" y="734">0 : N</text>
  <text class="verb" x="478" y="734">origina</text>

  <!-- R11 USUARIO -> MOVIMIENTO -->
  <path class="rel" d="M1470,320 H1810 V1070 H210 V800" marker-end="url(#ma)"/>
  <text class="card" x="900" y="1062">0 : N</text>
  <text class="verb" x="948" y="1062">ejecuta</text>

  <!-- ═══════════════ LEYENDA ═══════════════ -->
  <line class="sep" x1="60" y1="1110" x2="1780" y2="1110"/>
  <text class="zona" x="60" y="1136">Leyenda</text>

  <rect class="ent" x="60" y="1152" width="34" height="22"/>
  <text class="leg" x="104" y="1167">Entidad fuerte</text>

  <rect class="ent-deb" x="270" y="1152" width="34" height="22"/>
  <rect class="ent-deb-int" x="274" y="1156" width="26" height="14"/>
  <text class="leg" x="314" y="1167">Entidad debil</text>

  <rect class="ent-aso" x="480" y="1152" width="34" height="22"/>
  <text class="leg" x="524" y="1167">Entidad asociativa</text>

  <ellipse class="elip-der" cx="734" cy="1163" rx="30" ry="12"/>
  <text class="leg" x="774" y="1167">Atributo derivado</text>

  <line class="rel" x1="990" y1="1163" x2="1034" y2="1163" marker-end="url(#ma)"/>
  <text class="leg" x="1044" y="1167">Relacion 1:N</text>

  <line class="rel-amb" x1="1230" y1="1163" x2="1274" y2="1163" marker-end="url(#mb)"/>
  <text class="leg" x="1284" y="1167">Construccion extendida</text>

  <text class="pk" x="1540" y="1167">id</text>
  <text class="leg" x="1572" y="1167">Clave primaria</text>
</svg>
